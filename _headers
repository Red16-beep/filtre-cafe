/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' equateur.org https://app.equateur.org; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src 'self' fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.brevo.com https://equateur.org https://app.equateur.org https://geo.api.gouv.fr https://hubeau.eaufrance.fr; frame-ancestors 'none'; base-uri 'self'; form-action 'self';

/*.html
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/pins/*
  Cache-Control: public, max-age=604800

/videos/*
  Cache-Control: public, max-age=604800

/illustrations/*
  Cache-Control: public, max-age=604800

/404.html
  Cache-Control: no-store

# Versions e-mail de la lettre (gabarits Brevo) : accessibles mais hors index
/newsletter/nl-*
  X-Robots-Tag: noindex

/newsletter/bienvenue
  X-Robots-Tag: noindex

/newsletter/email-*
  X-Robots-Tag: noindex

# Carnet de bord, en bêta cachée : sa politique de sécurité est en <meta> dans carnet/index.html (requêtes vers
# OpenStreetMap et l'IGN), celle du site ne s'y applique pas ; la géolocalisation y est permise, à la demande.
/carnet/*
  ! Content-Security-Policy
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  X-Robots-Tag: noindex
