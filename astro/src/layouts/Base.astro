---
// Shared chrome for every page. Edit nav / footer / fonts / tracking ONCE here
// instead of in 80 files. Per-page <head> meta + JSON-LD + <style> arrive through
// the named "head" slot; the page body arrives through the default slot. Both are
// injected verbatim via <Fragment set:html> so nothing is re-escaped.
---
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="filtré." href="/rss.xml">
<slot name="head" />
<link rel="stylesheet" href="/tailwind.css">
<link rel="preload" href="/fonts/instrumentserif-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/instrumentserif-italic-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/fonts.css">

<slot name="style" />
<script is:inline defer src="https://equateur.org/assets/js/cmp.js" data-site="aff654dd0df3f7e406ecb0a7e78ced5a"></script>
</head>
<body class="antialiased">
<div class="noise"></div>
<div id="scroll-progress"></div>

<nav class="glass-nav fixed top-0 left-0 right-0 z-50 border-b border-stone-200/60">
  <div class="max-w-5xl mx-auto px-5 h-14 flex items-center justify-between">
    <a href="/" class="serif italic text-xl tracking-tight text-stone-900">filtré.</a>
    <div class="hidden md:flex items-center gap-8 text-[11px] font-semibold uppercase tracking-[0.18em] text-stone-400">
      <a href="/journal/" class="hover:text-stone-900 transition-colors">Le Journal</a>
      <a href="/materiel" class="hover:text-stone-900 transition-colors">Matériel</a>
      <a href="/newsletter" class="hover:text-stone-900 transition-colors">La Lettre</a>
      <a href="/a-propos.html" class="hover:text-stone-900 transition-colors">À propos</a>
    </div>
    <button onclick="document.getElementById('mobile-menu').classList.toggle('open')" class="md:hidden p-2 text-stone-500">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>
  <div id="mobile-menu" class="flex-col md:hidden border-t border-stone-200/60">
    <div class="mobile-menu-panel bg-stone-50/95 backdrop-blur-xl px-5 py-4 flex flex-col gap-6 text-[11px] font-semibold uppercase tracking-[0.18em] text-stone-500">
      <a href="/journal/" class="hover:text-stone-900 transition-colors">Le Journal</a>
      <a href="/materiel" class="hover:text-stone-900 transition-colors">Matériel</a>
      <a href="/newsletter" class="hover:text-stone-900 transition-colors">La Lettre</a>
      <a href="/a-propos.html" class="hover:text-stone-900 transition-colors">À propos</a>
    </div>
  </div>
</nav>

<slot />

<footer class="border-t border-stone-200 py-10 px-5">
  <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
    <span class="serif italic text-lg text-stone-900">filtré.</span>
    <div class="flex items-center gap-4">
      <a href="https://www.pinterest.com/filtrecafe/" rel="me noopener" target="_blank" aria-label="Pinterest" class="text-stone-400 hover:text-amber-600 transition-colors"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg></a>
      <a href="/rss.xml" aria-label="Flux RSS" class="text-stone-400 hover:text-amber-600 transition-colors"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="19" r="2.4"/><path d="M3 10.6a.9.9 0 0 1 .9-.9A10.4 10.4 0 0 1 14.3 20a.9.9 0 0 1-.9.9h-1.3a.9.9 0 0 1-.9-.85A7.3 7.3 0 0 0 3.95 12.8a.9.9 0 0 1-.85-.9zM3 4.1a.9.9 0 0 1 .9-.9A16.9 16.9 0 0 1 20.8 20.1a.9.9 0 0 1-.9.9h-1.3a.9.9 0 0 1-.9-.88A13.8 13.8 0 0 0 3.88 6.3.9.9 0 0 1 3 5.4z"/></svg></a>
    </div>
    <p class="text-xs text-stone-400 font-medium">© 2026 filtré. · Guide indépendant du café de spécialité</p>
  </div>
</footer>

<script is:inline>
window.addEventListener('scroll', () => {
  const el = document.getElementById('scroll-progress');
  const h = document.documentElement.scrollHeight - window.innerHeight;
  el.style.width = (window.scrollY / h * 100) + '%';
});
</script>
<script is:inline src="/nl-subscribe.js"></script>
<script is:inline defer src="https://equateur.org/tracker.js" data-equateur-key="aff654dd0df3f7e406ecb0a7e78ced5a"></script>
<script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="RyQips8fe/VJ31p20yJwGw" async></script>
<script is:inline defer src="/js/track.js"></script>
<script is:inline defer src="/js/newsletter-inline.js"></script>
<script is:inline defer src="/js/exit-intent.js"></script>
</body>
</html>
